# Copy to .env and fill in values. NEVER commit the real .env.
# These are used by the root docker-compose.yaml for the db and rabbitmq services.
# They MUST match the credentials in backend/vayy/.env:
#   DATABASE_URL=postgis://postgres:POSTGRES_PASSWORD@db:5432/vayy
#   CELERY_BROKER_URL=amqp://RABBITMQ_USER:RABBITMQ_PASSWORD@rabbitmq:5672/

POSTGRES_DB=vayy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

RABBITMQ_USER=vayy
RABBITMQ_PASSWORD=CHANGE_ME
