# VAYY | frontend build-time environment
# Copy to `frontend/.env` for local builds. Docker builds pass the same values
# as build args (see frontend/Dockerfile).

# API origin only. API_PATHS already carry the "/api/" prefix and WS paths the
# "/ws/" prefix, so this must be an ORIGIN (e.g. https://onmyvayy.com), never "/api".
VITE_API_URL=https://onmyvayy.com

# ---------------------------------------------------------------------------
# DYNAMIC_ROUTE_CREATION_ENABLED
# ---------------------------------------------------------------------------
# true  -> route creation calls POST /api/transport/routes/dynamic-preview/
#          and the existing Route Card renders the backend-generated
#          geometry, ordered stops and fare.
# false -> rollback to the legacy manually traced fixed-route lookup.
VITE_DYNAMIC_ROUTE_CREATION_ENABLED=true
