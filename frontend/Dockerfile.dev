# syntax=docker/dockerfile:1
# Dev image for the `webapp` compose service — Vite dev server with HMR on :5173.
#
# This is NOT the production image (see ./Dockerfile). The production image bakes
# BASE_PATH and VITE_API_URL at build time; the dev server reads them from
# .env / container environment at request time, so you get HMR without a rebuild.
#
# Pair with the compose `webapp` service, which bind-mounts ../frontend so source
# edits reload instantly. node_modules is kept in an anonymous volume so the
# bind mount cannot shadow the installed tree.
#
# Vite 7 requires Node 20.19+ / 22.12+.
FROM node:22-alpine

WORKDIR /app

# Install first so the layer caches independently of source edits.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# VITE_API_URL / VITE_DYNAMIC_ROUTE_CREATION_ENABLED come from the compose
# `webapp` service (env_file ../frontend/.env + environment overrides).
#
# Vite's loadEnv() merges process.env entries matching the VITE_ prefix, so
# container `environment:` values ARE exposed on import.meta.env — no .env write
# needed. BASE_PATH is deliberately left unset so `base` falls back to "/" and
# the router basename is "" — i.e. the dev server mounts at its own root.
EXPOSE 5173

# vite.config.js sets host: true and strictPort: true, which is what makes the
# port mapping reachable and makes a port clash fail loudly instead of silently
# incrementing to 5174.
CMD ["npm", "run", "dev"]