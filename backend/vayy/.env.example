# Copy to .env and fill in values. NEVER commit the real .env.

# ---- Core ----
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Set to True only after provisioning a TLS certificate and enabling the
# HTTPS server block in nginx.conf. When False (default), the stack runs
# over plain HTTP and no https:// redirects are issued.
ENABLE_HTTPS=False

# ---- Database (in-container PostGIS) ----
DATABASE_URL=postgis://postgres:CHANGE_ME@db:5432/vayy?sslmode=disable

# ---- RabbitMQ / Celery ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=vayy
RABBITMQ_PASSWORD=CHANGE_ME
CELERY_BROKER_URL=amqp://vayy:CHANGE_ME@rabbitmq:5672/
RABBITMQ_URL=amqp://vayy:CHANGE_ME@rabbitmq:5672/
CELERY_RESULT_BACKEND=rpc://

# Must match values set on the db service below when self-hosting via compose.
POSTGRES_DB=vayy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# ---- CORS ----
# Set to True only for quick local dev. In production, list specific origins.
CORS_ALLOW_ALL_ORIGINS=False
# Comma-separated list of allowed origins (for local admin dev, etc.)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- GDAL/GEOS (auto-detected by Django; set only if detection fails) ----
# GDAL_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgdal.so   # x86_64
# GEOS_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgeos_c.so
# or aarch64:
# GDAL_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu/libgdal.so
# GEOS_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu/libgeos_c.so

# ---- OSRM / Redis ----
OSRM_URL=http://osrm:5000
OSRM_MAX_SNAP_DISTANCE_M=5000
REDIS_URL=redis://redis:6379/0

# ---- Email (SMTP) ----
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_HOST_USER=apikey@yourprovider.com
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@vayy.com

# ---- Django admin superuser (created by entrypoint.sh) ----
DJANGO_SUPERUSER_USERNAME=root
DJANGO_SUPERUSER_EMAIL=root@vayy.com
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME

# ---- GeoIP (MaxMind) ----
GEOIP_MMDB_PATH=/app/geoip/GeoLite2-City.mmdb