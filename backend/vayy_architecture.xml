        <mxCell id="e1" edge="1" source="ui" target="api_client" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" source="api_client" target="auth_ctrl" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e3" edge="1" source="ride_ctrl" target="ride_srv" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
