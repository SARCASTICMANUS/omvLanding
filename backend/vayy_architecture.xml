        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- MOBILE -->
        <mxCell id="mobile_box" value="Mobile App" style="swimlane;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="220" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="ui" value="UI Layer" vertex="1" parent="mobile_box">
          <mxGeometry x="20" y="40" width="160" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="api_client" value="REST Client" vertex="1" parent="mobile_box">
          <mxGeometry x="20" y="90" width="160" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="mq_client" value="RabbitMQ Client" vertex="1" parent="mobile_box">
          <mxGeometry x="20" y="140" width="160" height="40" as="geometry"/>
        </mxCell>

        <!-- API LAYER -->
        <mxCell id="api_box" value="Django REST Layer" style="swimlane;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="260" y="250" width="300" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="auth_ctrl" value="AuthController" vertex="1" parent="api_box"><mxGeometry x="10" y="40" width="120" height="40" as="geometry"/></mxCell>
        <mxCell id="ride_ctrl" value="RideController" vertex="1" parent="api_box"><mxGeometry x="150" y="40" width="120" height="40" as="geometry"/></mxCell>
        <mxCell id="loc_ctrl" value="LocationController" vertex="1" parent="api_box"><mxGeometry x="10" y="90" width="120" height="40" as="geometry"/></mxCell>

        <mxCell id="auth_srv" value="AuthService" vertex="1" parent="api_box"><mxGeometry x="10" y="150" width="120" height="40" as="geometry"/></mxCell>
        <mxCell id="ride_srv" value="RideService" vertex="1" parent="api_box"><mxGeometry x="150" y="150" width="120" height="40" as="geometry"/></mxCell>
        <mxCell id="loc_srv" value="LocationService" vertex="1" parent="api_box"><mxGeometry x="10" y="200" width="120" height="40" as="geometry"/></mxCell>

        <mxCell id="repo" value="Repositories" vertex="1" parent="api_box">
          <mxGeometry x="80" y="250" width="140" height="40" as="geometry"/>
