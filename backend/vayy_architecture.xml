        <mxCell id="e8" edge="1" source="q_auto" target="loc_consumer" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" edge="1" source="q_bike" target="loc_consumer" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e10" edge="1" source="loc_consumer" target="match_srv" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" edge="1" source="match_srv" target="eta_srv" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e12" edge="1" source="eta_srv" target="db_box" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

