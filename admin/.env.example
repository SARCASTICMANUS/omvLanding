# Copy to .env and adjust per environment. NEVER commit the real .env.
#
# Only variables prefixed with VITE_ are inlined into the client bundle.

# Backend API base URL. Single var used for both the app and the dev proxy.
# "/api" = same-origin (proxied by nginx in production; the dev-server proxy
#          forwards /api to http://localhost:8000 in dev).
# Absolute HTTPS URL = admin and API on different origins (browser calls it
#          directly; CORS must be enabled on the API).
VITE_API_URL=/api
