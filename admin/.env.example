# Copy to .env and adjust per environment. NEVER commit the real .env.
#
# Only variables prefixed with VITE_ are inlined into the client bundle.

# Backend API base URL. Single var used for both the app and the dev proxy.
# "/api" = same-origin (proxied by nginx in production; the dev-server proxy
#          forwards /api to the proxy target below in dev).
# Absolute HTTPS URL = admin and API on different origins (browser calls it
#          directly; CORS must be enabled on the API).
VITE_API_URL=/api

# Backend origin used by the Vite dev-server proxy when VITE_API_URL is "/api".
VITE_API_PROXY_TARGET=http://localhost:8000

# OpenStreetMap Nominatim geocoding service (search + reverse).
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Base map style used by the route planner (MapLibre GL).
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json

# YouTube IFrame Player API.
VITE_YOUTUBE_IFRAME_API=https://www.youtube.com/iframe_api
